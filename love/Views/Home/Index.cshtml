                               </div>
                               <div class="col-md-3">
                                   <div class="counter" id="minutes">0</div>
                                   <div class="label">Dakika</div>
                               </div>
                               <div class="col-md-3">
                                   <div class="counter" id="seconds">0</div>
                                   <div class="label">Saniye</div>
                               </div>
